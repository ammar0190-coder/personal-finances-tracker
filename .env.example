# Copy to .env.local for local dev, or set these in Vercel for production.
# See docs/HANDOFF_USER.md for how to get real values.

# Supabase project settings > API. For local dev via `supabase start`, these
# come from that command's own output instead (fixed local values).
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only — never exposed to the browser, never prefixed NEXT_PUBLIC_.
# Needed only for admin-level operations (e.g. RLS integration tests).
SUPABASE_SECRET_KEY=your-secret-key
